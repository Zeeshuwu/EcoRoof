# ---------------------------------------------------------------------------
# EcoRoof — .gitignore
# Public repo. Code, docs and the paper only. No imagery, no DEMs, no model
# weights, no computed outputs.
# ---------------------------------------------------------------------------

# --- Secrets. Never commit. ------------------------------------------------
.streamlit/secrets.toml
secrets.toml
*.key
.env
.env.*

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments --------------------------------------------------
venv/
.venv/
env/
ENV/

# --- Model weights and checkpoints ----------------------------------------
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
weights/
checkpoints/
sam3_logs/

# --- Input data ------------------------------------------------------------
# Orthophotos, ground truth and DEMs are Geo-AIT data and are not
# redistributed here. The three province DEMs are each over GitHub's 100 MB
# hard limit in any case. README documents the expected folder layout.
input/
*.tif
*.tiff
*.tif.aux.xml
*.tfw
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx

# --- Computed outputs ------------------------------------------------------
output/
output[0-9]*/
outputCOBA*/
outputOrto*/
output_ablation/
output_inference/
revisi_r2/cache/
revisi_r2/tmp/
revisi_r2/results/
revisi_r2/figures/

# --- Archives and scratch --------------------------------------------------
*.zip
*.rar
*.7z
figures/from_draft/
figures/from_revisions/
figures/rev_sheet.png

# --- Papers, manuscripts and revision documents ----------------------------
# This repository is the application. Paper artefacts live elsewhere.
*.pdf
*.docx
*.pptx
paper/
manuscript/
figures/

# --- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
